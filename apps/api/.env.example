# Copy to .env in this directory for local `pnpm --filter @agterra/api dev`
# (Nest reads process.env directly / via @nestjs/config; this file is not
# auto-loaded by anything — export these into your shell, or use a tool
# like `dotenv-cli`/`direnv` that loads apps/api/.env before running `nest
# start`.) Matches docker-compose.yml at the repo root for local Postgres.

# --- Database (packages/db's PrismaService reads this) ---
DATABASE_URL="postgresql://agterra:agterra_dev_password@localhost:5432/agterra?schema=public"

# --- Investor auth plane (/v1/auth/*, `users` table) ---
# Required, no default — the app throws at first use if unset.
JWT_INVESTOR_ACCESS_SECRET="change-me-investor-access-secret"
JWT_INVESTOR_REFRESH_SECRET="change-me-investor-refresh-secret"
# Optional — shown here at their defaults.
# JWT_INVESTOR_ISSUER="agterra-investor-auth"
# JWT_INVESTOR_AUDIENCE="agterra-investor"
# JWT_INVESTOR_ACCESS_TTL="15m"
# JWT_INVESTOR_REFRESH_TTL="30d"

# --- Admin auth plane (/v1/admin/auth/*, `admin_users` table) ---
# Required, no default. MUST be different values from the investor secrets
# above — that separation is the whole point of the two-plane design (see
# root CLAUDE.md's Authentication section). Nothing enforces this at
# runtime beyond using two different env vars; treat it as an operational
# invariant when provisioning secrets.
JWT_ADMIN_ACCESS_SECRET="change-me-admin-access-secret"
JWT_ADMIN_REFRESH_SECRET="change-me-admin-refresh-secret"
# Optional — shown here at their defaults.
# JWT_ADMIN_ISSUER="agterra-admin-auth"
# JWT_ADMIN_AUDIENCE="agterra-admin"
# JWT_ADMIN_ACCESS_TTL="10m"
# JWT_ADMIN_REFRESH_TTL="12h"

# --- AI Analyst (/v1/properties/:id/ai/ask) ---
# Required for the AI Analyst endpoint to function; if unset, the endpoint
# returns a clean 503 rather than crashing (see ai-analysis.service.ts).
# Not yet provisioned as of this endpoint's initial build.
# ANTHROPIC_API_KEY="change-me-anthropic-api-key"
# Optional — defaults to "claude-sonnet-5" if unset.
# AI_MODEL="claude-sonnet-5"

# --- Monetization / Stripe (/v1/subscriptions/*, /v1/properties/:id/reports/checkout, /v1/webhooks/stripe) ---
# Required for checkout/webhook endpoints to function; if unset, checkout
# endpoints return a clean 503 (see monetization/stripe-client.service.ts)
# rather than crashing. Not yet provisioned — no Stripe account exists yet.
# STRIPE_SECRET_KEY="sk_test_change-me"
# Required for POST /v1/webhooks/stripe to verify Stripe's signature; if
# unset, the webhook returns a clean 503. Get this from the Stripe
# Dashboard's webhook endpoint configuration (or `stripe listen` for local
# dev) once a Stripe account exists — see stripe-webhook.service.ts.
# STRIPE_WEBHOOK_SECRET="whsec_change-me"

# --- Server ---
# PORT=3001
