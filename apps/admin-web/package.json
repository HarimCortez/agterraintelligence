{
  "name": "@agterra/admin-web",
  "private": true,
  "version": "0.0.0",
  "description": "AgTerra Intelligence admin console (Next.js App Router), a separate deployment target per the architecture's admin/investor plane-isolation decision. Phase 0 skeleton — no modules implemented yet.",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3100",
    "start": "next start --port 3100",
    "lint": "next lint --max-warnings 0",
