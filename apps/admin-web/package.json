    "test": "echo \"no tests yet\" && exit 0",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@agterra/ui": "workspace:*",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@agterra/config": "workspace:*",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.5.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.5.28",
    "tailwindcss": "3",
    "typescript": "^5.7.2"
  }
}
