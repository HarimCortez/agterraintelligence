# Copy to .env in this directory for local Prisma CLI usage (generate/migrate/studio).
# apps/api reads DATABASE_URL from its own runtime env config, not from this file --
# this .env is consumed by the Prisma CLI only.
#
# Matches docker-compose.yml at the repo root (POSTGRES_USER/PASSWORD/DB below).
DATABASE_URL="postgresql://agterra:agterra_dev_password@localhost:5432/agterra?schema=public"
