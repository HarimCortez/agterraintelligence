// AgTerra Intelligence — Prisma schema
//
// Scope: Identity & Access domain only (Phase 0 continuation), per
// ARCHITECTURE.md's "Database Changes" > "Identity & accounts" section.
//
// Do NOT add properties/geospatial, monetization, engagement, or AI/support
// tables here yet — those land in later phases per ARCHITECTURE.md's build
// sequence. The `postgis` extension is enabled now (via the datasource
// `extensions` list below) because enabling an extension requires a
// migration, even though no geometry/geography columns exist in this pass.
//
// Org-seam requirement (ARCHITECTURE.md "Implementation Constraints" #1):
// `organizations` and `users.org_id` ship in this, the first migration —
// not deferred. `org_id` is nullable and unpopulated for every MVP user;
// AccountContext resolution (org if present, else self) is `be`'s concern,
// not this schema's.
//
// Admin auth-plane isolation (Implementation Constraints, PRD Decision 6):
// `admin_users` is a wholly separate table from `users`, not a role flag,
// so a compromised investor session can never reach admin surface via the
// data model.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // PostGIS is enabled here (Phase 0) even though no geometry/geography
  // columns exist yet — Property & Geospatial tables (properties, reference
  // layers, etc.) land in Phase 1 and will consume this same extension.
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// Organizations (org-seam — present, unused in MVP)
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  active
  suspended
  closed

  @@map("organization_status")
}

model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  billingAccountId String?            @map("billing_account_id")
  status           OrganizationStatus @default(active)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  users User[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Investor-plane users
// ---------------------------------------------------------------------------

// External RBAC (7 roles) — REQUIREMENTS.md Section 9.4 / ARCHITECTURE.md.
// `team_admin`/`team_member` are dormant per Product Decision #1: the enum
// values ship now, but no logic depends on them until `org_id` is populated.
enum ExternalRole {
  free
  basic_subscriber
  investor_subscriber
  professional_subscriber
  institutional
  team_admin
  team_member

  @@map("external_role")
}

enum UserStatus {
  pending_verification
  active
  suspended
  deactivated

  @@map("user_status")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  externalRole ExternalRole @default(free) @map("external_role")

  // Org-seam: nullable today, populated only once org support activates.
  // Downstream code must resolve tenancy via AccountContext, never by
  // querying this column directly as the sole scope boundary (be's concern).
  orgId String?       @map("org_id") @db.Uuid
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  status    UserStatus @default(pending_verification)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  watchlistItems  WatchlistItem[]
  savedSearches   SavedSearch[]
  subscription    Subscription?
  reportOrders    ReportOrder[]
  supportTickets  SupportTicket[]
  supportMessages SupportTicketMessage[] @relation("SupportTicketMessageUserSender")

  @@index([orgId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Admin-plane users (separate table — auth-plane isolation)
// ---------------------------------------------------------------------------

// Internal RBAC (8 roles) — REQUIREMENTS.md Section 9.4 persona table.
enum InternalRole {
  super_admin
  admin
  support_agent
  data_qa_reviewer
  report_fulfillment_manager
  billing_manager
  ai_model_monitor
  readonly_analyst

  @@map("internal_role")
}

enum AdminUserStatus {
  active
  suspended
  deactivated

  @@map("admin_user_status")
}

model AdminUser {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  internalRole InternalRole @map("internal_role")

  // Nullable: populated during MFA enrollment, which happens after account
  // creation. `be`'s admin-auth module is expected to refuse admin login
  // until this is set, per ARCHITECTURE.md's "MFA-required" admin session
  // policy — that check is application logic, not a NOT NULL constraint,
  // since an admin_users row must be creatable before enrollment completes.
  mfaSecret String? @map("mfa_secret")

  status    AdminUserStatus @default(active)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  reviewedPermissions    RolePermission[]       @relation("RolePermissionUpdatedBy")
  refreshTokens          AdminRefreshToken[]
  auditLogEntries        AuditLogEntry[]
  assignedSupportTickets SupportTicket[]        @relation("SupportTicketAssignee")
  supportMessages        SupportTicketMessage[] @relation("SupportTicketMessageAdminSender")

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Admin RBAC policy table
// ---------------------------------------------------------------------------

// Table-driven internal RBAC (ARCHITECTURE.md "Authentication / Authorization"
// > "Internal RBAC"): `be` checks `(role, permission_key) -> allowed` here
// instead of branching on role in code, so new permission keys (e.g.
// `billing.refund`, `data.edit`, `ai_settings.write`, `audit_log.read`) can
// be added by inserting rows, not redeploying.
model RolePermission {
  id            String       @id @default(uuid()) @db.Uuid
  role          InternalRole
  permissionKey String       @map("permission_key")
  allowed       Boolean      @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Optional audit trail of which admin last changed a policy row — useful
  // once the Administration Settings screen lets Super Admins edit this
  // table, but not required for it to function.
  updatedById String?    @map("updated_by_id") @db.Uuid
  updatedBy   AdminUser? @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([role, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Admin audit log
// ---------------------------------------------------------------------------
//
// General-purpose audit trail, distinct from RolePermission.updatedById
// above (which only covers one specific table's edits). Added alongside
// the admin-audit module (apps/api/src/admin-audit) — its first two real
// writers are admin login attempts (success and failure, including a
// failed attempt against an email with no matching admin_users row, hence
// actorId being nullable) and the Report Fulfillment retry action. Not a
// blanket "log every mutation" system yet — write calls are added
// deliberately at each real admin action as it's built, not retrofitted
// everywhere speculatively.
model AuditLogEntry {
  id String @id @default(uuid()) @db.Uuid

  // Nullable + a separately-stored actorEmail (not just a FK) because a
  // failed login against an unrecognized email has no admin_users row to
  // reference at all, and a real admin's own row surviving account
  // deletion isn't something this table should depend on either.
  actorId    String?    @map("actor_id") @db.Uuid
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorEmail String?    @map("actor_email")

  // Free-string action key (e.g. "admin.login.success", "fulfillment.retry"),
  // matching RolePermission.permissionKey's precedent of a free string over
  // an enum — new action types shouldn't need a migration to add.
  action String

  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_log_entries")
}

// ---------------------------------------------------------------------------
// Ingestion run history
// ---------------------------------------------------------------------------
//
// Tracks executions of real external-data ingestion jobs. Two real jobs
// share this table today:
// - apps/api/src/ingestion/fema-flood-zone-ingestion.service.ts, which
//   queries FEMA's public National Flood Hazard Layer for each
//   property's coordinates and creates real property_risk_flags rows
//   for properties in a Special Flood Hazard Area.
// - apps/api/src/ingestion/fl-parcel-cadastral-ingestion.service.ts,
//   which queries the Florida Dept. of Revenue's real statewide parcel
//   cadastral dataset for real agricultural parcels (DOR use codes
//   50-69) in the platform's covered counties and creates real
//   ParcelRecord rows.
// Every property/report/subscription table in this schema is otherwise
// populated by a one-time seed script (packages/db/prisma/seed.ts) —
// this is the first table backing a real, re-runnable, external-data-
// backed operation, not seed data.
enum IngestionRunStatus {
  running
  succeeded
  failed

  @@map("ingestion_run_status")
}

model IngestionRun {
  id     String             @id @default(uuid()) @db.Uuid
  source String
  status IngestionRunStatus @default(running)

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  // Renamed from propertiesChecked/flagsCreated once a second real
  // ingestion job (fl_dor_cadastral, alongside fema_flood_zones) needed
  // this same run-history table — those names were specific to FEMA's
  // "check a property, maybe create a risk flag" shape and didn't fit a
  // job that ingests parcel records instead. Generic across every real
  // ingestion job this table now backs.
  itemsProcessed Int @default(0) @map("items_processed")
  recordsCreated Int @default(0) @map("records_created")

  errorMessage String? @map("error_message") @db.Text

  @@index([source])
  @@index([startedAt])
  @@map("ingestion_runs")
}

// ---------------------------------------------------------------------------
// Rotating refresh token storage (added by `be` on top of `data`'s original
// Identity & Access schema, still within Phase 0 / Identity & Access scope)
// ---------------------------------------------------------------------------
//
// ARCHITECTURE.md's Authentication/Authorization section calls for "rotating
// refresh tokens" on both auth planes. That requires somewhere to persist
// the current valid token per session so a refresh can be verified, rotated
// (old marked used/revoked, new issued), and revoked on logout — none of
// `data`'s four original tables cover this, so `be` is adding it here rather
// than approximating rotation statelessly. Mirrors the existing
// users/admin_users separation: two tables, not one polymorphic table, so
// the plane isolation the architecture calls for extends to session storage
// too. Flagging for `data`/`arch` awareness since it's a schema addition
// made outside the original hand-off.
//
// Only a SHA-256 hash of the opaque token value is stored (`token_hash`),
// never the raw token — the raw value is returned to the client once, at
// issuance, embedded in a signed JWT (see `be`'s TokenService). Rotation
// chains are threaded via `replaced_by_id` so token reuse (presenting an
// already-rotated token) is detectable and treated as a signal to revoke
// the whole chain.

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces     RefreshToken? @relation("RefreshTokenRotation")

  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  @@index([userId])
  @@map("refresh_tokens")
}

model AdminRefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  replacedById String?            @unique @map("replaced_by_id") @db.Uuid
  replacedBy   AdminRefreshToken? @relation("AdminRefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces     AdminRefreshToken? @relation("AdminRefreshTokenRotation")

  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  @@index([adminUserId])
  @@map("admin_refresh_tokens")
}

// ---------------------------------------------------------------------------
// Property & Geospatial — first-pass slice for "Discover + Map Workspace"
// ---------------------------------------------------------------------------
//
// Scope note: this is deliberately narrower than the full Property &
// Geospatial design in ARCHITECTURE.md's "Database Changes" section. Built
// here: `properties`, `opportunity_scores`, `property_valuations`,
// `property_risk_flags` — enough for a ranked/filterable list+map view.
// NOT built here (later phases per ARCHITECTURE.md's build sequence):
// `comparables`, `property_data_sources`, reference geospatial layers
// (`county_boundaries`, `soil_map_units`, `flood_zones`, `wetland_areas`),
// `boundary` polygon on `properties`, and anything monetization/report-
// related. Escalate to `arch` before adding any of those.
//
// PostGIS note: `location` uses Prisma's `Unsupported(...)` type because
// Prisma Client has no native geography type. This means the generated
// Prisma Client cannot read/write `location` through normal model queries —
// reads/writes of `location` must go through `$queryRaw`/`$executeRaw`
// (e.g. `ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography`). The GIST
// index on `location` is added by hand in the migration SQL (Prisma does
// not know how to index an Unsupported column from schema alone).
//
// KNOWN FOOTGUN: because that GIST index (and the hand-added CHECK
// constraints in the same migration) are invisible to Prisma's schema
// model, running `prisma migrate dev` again locally will report phantom
// drift and offer to generate a follow-up migration that DROPS
// `properties_location_idx`. Do not accept that prompt. Use
// `prisma migrate deploy` for repeatable/CI applies (it only replays
// pending migration files, no interactive schema-diff step); if a real new
// migration is needed via `migrate dev`, review the generated SQL and
// strip any `DROP INDEX "properties_location_idx"` before applying.

enum ListingStatus {
  active
  pending
  sold
  off_market

  @@map("listing_status")
}

// Florida agricultural land-use categories — covers the range `properties`
// seed data and the Discover workspace need for MVP. Not exhaustive of every
// FL ag classification; extend via migration as real ingestion sources
// surface categories not covered here.
enum LandUseType {
  row_crop
  pasture
  timber
  citrus
  mixed_agricultural
  vacant_agricultural

  @@map("land_use_type")
}

// Matches PRD's Opportunity Score bands (REQUIREMENTS.md Section 8.1)
// exactly: 90-100 exceptional, 80-89 strong, 70-79 promising, 60-69 watch,
// <60 limited. Stored explicitly (not derived by callers) per spec; a CHECK
// constraint (see migration SQL) enforces score/band consistency at the DB
// level so a bad write can never desync the two.
enum OpportunityBand {
  exceptional
  strong
  promising
  watch
  limited

  @@map("opportunity_band")
}

// Data-confidence states required by REQUIREMENTS.md Section 7.2 / DoD #7 —
// same four states ARCHITECTURE.md's fuller `property_data_sources` design
// uses; here applied at the valuation level since field-level confidence
// tracking (`property_data_sources`) is out of scope for this pass.
enum ValuationConfidence {
  verified
  modeled
  ai_inferred
  unknown

  @@map("valuation_confidence")
}

enum RiskSeverity {
  low
  medium
  high

  @@map("risk_severity")
}

model Property {
  id String @id @default(uuid()) @db.Uuid

  county String
  state  String @default("FL")

  // Unique per-parcel identifier from the county property appraiser /
  // source system. Real dedup/ingestion matching (ARCHITECTURE.md's
  // "Ingestion" data flow) is a later phase; the unique constraint here is
  // the minimum integrity guarantee for this pass.
  parcelId String @unique @map("parcel_id")

  // Human-readable label for the property card/list (e.g. "1,200-Acre Row
  // Crop Tract, Okeechobee County") — rural agricultural parcels frequently
  // have no real street address, so this is a display label, not a mailing
  // address. Named `address` to match ARCHITECTURE.md's field name.
  address String

  // geography(Point, 4326) — see file-header PostGIS note. NOT NULL: every
  // property needs a location to render on the map.
  location Unsupported("geography(Point, 4326)")

  acreage          Decimal       @db.Decimal(10, 2)
  askingPriceCents Int           @map("asking_price_cents")
  listingStatus    ListingStatus @default(active) @map("listing_status")
  landUseType      LandUseType   @map("land_use_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opportunityScore OpportunityScore?
  valuation        PropertyValuation?
  riskFlags        PropertyRiskFlag[]
  soilData         PropertySoilData?
  cropCover        PropertyCropCover?
  agCensusSummary  PropertyAgCensusSummary?
  timberSummary    PropertyTimberSummary?
  aiInteractions   AiInteraction[]
  watchlistItems   WatchlistItem[]
  reportOrders     ReportOrder[]
  supportTickets   SupportTicket[]

  @@index([county])
  @@index([state])
  @@index([listingStatus])
  @@index([landUseType])
  @@map("properties")
}

// One-to-one with `properties`. `band` is stored (not recomputed by
// callers) but kept consistent with `score` via a DB CHECK constraint
// (added by hand in migration SQL) matching the PRD's band ranges exactly.
model OpportunityScore {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @unique @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  score Int
  band  OpportunityBand

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([band])
  @@index([score])
  @@map("opportunity_scores")
}

// One-to-one with `properties`. `discount_pct` is signed: positive means
// asking price sits below AgTerra's estimated value (undervalued); negative
// means asking price exceeds the estimate.
model PropertyValuation {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @unique @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  estimatedValueCents Int                 @map("estimated_value_cents")
  discountPct         Decimal             @map("discount_pct") @db.Decimal(6, 2)
  confidence          ValuationConfidence

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([confidence])
  @@map("property_valuations")
}

// Many-per-property. `risk_type` is intentionally a free string, not an
// enum — the real risk taxonomy isn't defined yet (per hand-off scope);
// revisit as an enum once that taxonomy is confirmed with `arch`/`ux`.
model PropertyRiskFlag {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  riskType    String       @map("risk_type")
  severity    RiskSeverity
  description String       @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@index([severity])
  @@map("property_risk_flags")
}

// One-to-one with `properties`. Real USDA NRCS SSURGO soil survey data for
// the property's actual coordinates (`properties.location`) — see
// `apps/api/src/ingestion/usda-soil-ingestion.service.ts`'s doc comment.
// Unlike the FL parcel cadastral data (kept in its own `ParcelRecord`
// table, deliberately never merged into `properties`, because the
// fabricated `askingPriceCents`/listing data shouldn't borrow credibility
// from real data it's attached to) — this IS attached directly to
// `properties`, matching the already-established precedent of
// `PropertyRiskFlag`'s real FEMA flood-zone flags: soil type/drainage/slope
// are physical facts about a real point on Earth, true regardless of
// whether the "listing" at that point is real, so attaching them to the
// (fabricated) listing doesn't manufacture false credibility the way
// merging fabricated pricing into real parcel records would have.
model PropertySoilData {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @unique @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /** SSURGO map unit key — the stable identifier for the soil map unit at this point. */
  mapUnitKey String @map("map_unit_key")
  /** SSURGO map unit symbol, e.g. "19". */
  mapUnitSymbol String @map("map_unit_symbol")
  /** SSURGO map unit name, e.g. "Floridana, Placid, and Okeelanta soils, frequently flooded" — the closest thing to a "soil type" a non-specialist reads directly. */
  mapUnitName String @map("map_unit_name") @db.Text

  /** Dominant-condition drainage class, e.g. "Well drained", "Very poorly drained" (`muaggatt.drclassdcd`). */
  drainageClass String? @map("drainage_class")
  /** Dominant-condition flood frequency, e.g. "None", "Occasional", "Frequent" (`muaggatt.flodfreqdcd`). */
  floodFrequency String? @map("flood_frequency")
  /** Representative slope, percent (`muaggatt.slopegraddcp`). */
  slopePercent Decimal? @db.Decimal(5, 2) @map("slope_percent")
  /** Non-irrigated capability class, dominant condition, e.g. "3e", "4w" — USDA's 1 (best) to 8 (worst) cropland suitability scale, with a letter suffix for the limiting factor (`muaggatt.niccdcd`). */
  capabilityClass String? @map("capability_class")
  /** Percent of the map unit classified hydric (wetland-indicator soils), 0-100 (`muaggatt.hydclprs`). */
  hydricPct Int? @map("hydric_pct")

  ingestedAt DateTime @default(now()) @map("ingested_at")

  @@map("property_soil_data")
}

// One-to-one with `properties`. The real USDA NASS Cropland Data Layer (CDL)
// classification at the property's coordinates for the most recent year
// published for that location — see
// `apps/api/src/ingestion/cropland-data-client.ts`'s doc comment for how
// this was sourced (Microsoft Planetary Computer's free, keyless hosting
// of the same public-domain USDA data, after Google Earth Engine turned
// out to require a paid commercial plan and the USDA's own direct query
// API turned out to have an expired TLS certificate). Same
// never-merge-into-`properties` reasoning as `PropertySoilData`: this is a
// physical, satellite-observed fact about the point, independent of
// whether the listing there is real.
//
// Deliberately NOT reconciled against `properties.land_use_type` — the
// CDL's ~130 categories don't map cleanly onto that 6-value enum, and a
// lossy translation would misrepresent what the satellite actually saw.
// Shown alongside the self-reported land use instead, so a reader can
// compare "Listed: Citrus" against "USDA satellite (2021): Oranges"
// themselves.
model PropertyCropCover {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @unique @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /** The CDL classification year this reading came from — the most recent year with published coverage for this exact point, not necessarily the current calendar year. */
  year Int
  /** Raw CDL class code, e.g. 212. */
  cropCode Int @map("crop_code")
  /** Human-readable class name, e.g. "Oranges" — read directly from the source's own per-tile classification metadata, not a hand-maintained lookup table. */
  cropDescription String @map("crop_description") @db.Text

  ingestedAt DateTime @default(now()) @map("ingested_at")

  @@map("property_crop_cover")
}

// One-to-one with `properties`. Real, county-level USDA NASS Census of
// Agriculture figures for the property's own county — see
// `apps/api/src/ingestion/nass-ag-census-client.ts`'s doc comment for how
// this was sourced (NASS's free, keyless bulk data files, after the live
// Quick Stats API turned out to require a registered API key delivered by
// email — the first source in this project without a keyless path; every
// prior USDA/USFWS/FEMA source used here needed no registration at all).
//
// Deliberately narrow and deliberately NOT a parcel-level fact like
// `PropertySoilData`/`PropertyCropCover`: this is the same county-wide
// average attached to every property in that county, not something
// specific to this exact point. Scoped to the Census of Agriculture
// (published every 5 years: 2022, 2017, 2012...) because that's the only
// program with COUNTY-granularity for these figures — confirmed live that
// the annual Survey program (the one that would give a fresher, non-Census
// year) only publishes Florida citrus yield/price/production at
// STATE/NATIONAL level, not county. Cattle inventory scoped to
// `domain_desc = "TOTAL"` and land value to the county-wide average across
// all agricultural land uses pooled together (irrigated, cropland,
// pastureland, timber, etc.) — a rough county benchmark for comparison,
// not a same-land-use appraisal comp.
model PropertyAgCensusSummary {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @unique @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /** The Census of Agriculture year this reading came from, e.g. 2022. */
  year Int

  /** County-wide cattle (incl. calves) inventory, in head — null if NASS withheld the county total for disclosure reasons. */
  countyCattleInventoryHead Int? @map("county_cattle_inventory_head")
  /** County-wide average agricultural land (incl. buildings) value, in cents per acre, pooled across all land uses — null if NASS withheld the county total. */
  countyAgLandValueCentsPerAcre Int? @map("county_ag_land_value_cents_per_acre")

  ingestedAt DateTime @default(now()) @map("ingested_at")

  @@map("property_ag_census_summary")
}

// One-to-one with `properties`. Real, county-level USDA Forest Service
// Forest Inventory and Analysis (FIA) figures for the property's own
// county — see `apps/api/src/ingestion/fia-timber-client.ts`'s doc
// comment for how this was sourced (the free, keyless FIADB-API — no
// registration, no bulk-file workaround needed, unlike
// `PropertyAgCensusSummary`'s NASS source).
//
// Same "county-wide, not parcel-specific" reasoning as
// `PropertyAgCensusSummary`, but scoped to `landUseType: "timber"`
// properties only (like `CitrusQuarantineIngestionService`) rather than
// swept across every property — county timber volume isn't clearly
// relevant context for a citrus or row-crop parcel the way land value
// was for every land use in the ag census job.
//
// `countyTimberVolumeSamplingErrorPct` is deliberately stored alongside
// the estimate, not discarded: FIA's county-level figures are
// design-based statistical estimates from a sparse field-plot sample
// (single digits to low dozens of plots per county), and the published
// sampling error genuinely varies a lot by county size — confirmed live
// across this project's 5 target counties, from 18% (Polk, 56+ plots) up
// to 46% (Okeechobee, 7 plots). Surfacing that honestly, not presenting
// the estimate as precise, matches how every other real-but-uncertain
// figure in this schema is handled.
//
// Plot-level geolocation was deliberately not pursued even though FIA
// technically publishes plot coordinates: they're legally fuzzed/swapped
// within roughly half a mile to a mile (Food Security Act privacy
// protections for private landowners, confirmed via the Forest Service's
// own Spatial Data Services documentation) — county is the finest
// granularity the source actually offers, not a limitation this project
// is working around.
model PropertyTimberSummary {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @unique @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /** The most recent year in the FIA evaluation panel this reading came from, e.g. 2022 (the panel itself spans multiple years of field visits). */
  year Int

  /** County-wide timberland area, in acres. */
  countyTimberlandAcres Int? @map("county_timberland_acres")
  /** County-wide net merchantable timber volume density, in cubic feet per acre of timberland (computed by dividing FIA's total volume estimate by its total timberland-acres estimate for the same county). */
  countyTimberVolumeCuFtPerAcre Int? @map("county_timber_volume_cu_ft_per_acre")
  /** FIA's published sampling error for the underlying volume estimate, as a percent (e.g. 31.6) — a real measure of how much to trust the figure, not a fixed/precise number. */
  countyTimberVolumeSamplingErrorPct Decimal? @db.Decimal(5, 2) @map("county_timber_volume_sampling_error_pct")

  ingestedAt DateTime @default(now()) @map("ingested_at")

  @@map("property_timber_summary")
}

// ---------------------------------------------------------------------------
// AI Interactions — AI Response Storage
// ---------------------------------------------------------------------------
//
// Stores structured AI interactions (questions, analyses, responses) scoped
// initially to single-property context (v1) per REQUIREMENTS.md's decision log.
// Designed to accommodate future context types (report, comparison, portfolio)
// via `context_type` string field, but no UI/endpoint for user feedback yet —
// `feedback` column omitted until that workflow is implemented.
//
// `response` is stored as JSONB holding the structured shape per
// ARCHITECTURE.md's AI Response Pattern: { conclusion, evidence, risks,
// confidence, sources, nextAction }. Internal shape validation is the
// application layer's responsibility, not enforced at the DB level.

model AiInteraction {
  id String @id @default(uuid()) @db.Uuid

  // Nullable FK to properties — scoped to property context in v1, but allows
  // future context types (report, comparison, portfolio). Other context types
  // will reference different tables (once created), so property_id is nullable.
  propertyId String?   @map("property_id") @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Context type (e.g. "property", "report", "comparison", "portfolio").
  // Kept as free string (not enum) since the full set isn't finalized yet —
  // revisit as enum once confirmed.
  contextType String @map("context_type")

  // User question that prompted this response. Null for auto-generated
  // analyses/theses not prompted by a specific user question.
  question String? @db.Text

  // Structured AI response (JSONB). Shape per ARCHITECTURE.md's AI Response
  // Pattern: { conclusion, evidence, risks, confidence, sources, nextAction }.
  // Application layer handles internal validation.
  response Json

  // Which Claude model version generated this response (e.g. "claude-3-5-sonnet").
  modelVersion String @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@index([contextType])
  @@index([createdAt])
  @@map("ai_interactions")
}

// ---------------------------------------------------------------------------
// User Watchlist — per-user tracked properties
// ---------------------------------------------------------------------------
//
// Stores which properties a user is monitoring. Each watchlist_item row
// represents one property a user has added to their watchlist.
// ON DELETE CASCADE ensures that deleting a user or a property removes
// the corresponding watchlist entries.
// A unique constraint on (user_id, property_id) prevents duplicate entries.

model WatchlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("watchlist_items")
}

// ---------------------------------------------------------------------------
// Saved Searches — per-user saved search criteria
// ---------------------------------------------------------------------------
//
// Stores user-defined saved searches with filter criteria.
// `criteria` is a JSONB column holding the search filter shape:
// { minPrice, maxPrice, minAcreage, maxAcreage, minScore, maxScore,
//   band[], landUseType[], county, sort }
// The application layer is responsible for validating the internal shape.
// ON DELETE CASCADE ensures that deleting a user removes all their saved searches.

model SavedSearch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name      String // User-supplied label (e.g. "Okeechobee under $1M")
  criteria  Json // JSONB: filter criteria shape per GET /v1/properties query params
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("saved_searches")
}

// ---------------------------------------------------------------------------
// Monetization — subscriptions, report-tier catalog, report orders
// ---------------------------------------------------------------------------
//
// Scope: the billing *record* behind `users.external_role`, per
// REQUIREMENTS.md decision log items 9/10 and ARCHITECTURE.md's Monetization
// section (`/v1/subscriptions/*`, `/v1/report-tiers`, `/v1/report-orders/*`).
// `external_role` remains the fast-access tier flag application code checks
// for authorization; `subscriptions` is the underlying paid-plan record that
// keeps it in sync (that sync job is `be`'s concern, not this schema's).
//
// - Free is not represented as a `Subscription` row — it's the absence of
//   one (and the user's default `external_role = free`). Institutional is
//   out of scope entirely per the decision log (custom/sales-quoted).
// - One active subscription per user for v1: `userId` is unique.
// - `report_tiers` is small seeded reference data (four rows: essential,
//   investor, professional, premium), not user-generated — see
//   `prisma/seed.ts`. Premium has a row (pricing-page display) but isn't
//   purchasable yet (`requiresHumanReview = true`; the review-queue
//   subsystem that would move a Premium order out of `awaiting_review`
//   doesn't exist yet).
// - `report_orders.status` carries the full state machine from
//   ARCHITECTURE.md's fulfillment path (`pending_payment` -> `queued` ->
//   `generating` -> `awaiting_review`/`approved` -> `delivered`, with
//   `failed`/`refunded` branches) even though this pass's automated tiers
//   only ever exercise pending_payment -> queued -> generating ->
//   delivered/failed — Premium's future review-queue routing reuses the
//   same enum rather than requiring a breaking migration later.
// - `upgradeCreditAppliedCents` and `pricePaidCents` follow ARCHITECTURE.md's
//   Implementation Constraint #4: upgrade-credit math is computed against
//   the price actually paid, never against tier list price.

enum SubscriptionPlan {
  basic
  investor
  professional

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  incomplete

  @@map("subscription_status")
}

model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  plan SubscriptionPlan

  // Null until the user's first Stripe interaction (e.g. Checkout session
  // created but not yet completed).
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  status           SubscriptionStatus
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

// Small seeded reference/lookup table (not per-user data) — see
// `prisma/seed.ts` for the four canonical rows and confirmed launch prices.
model ReportTier {
  code String @id

  displayName             String  @map("display_name")
  subscriberPriceCents    Int     @map("subscriber_price_cents")
  nonSubscriberPriceCents Int     @map("non_subscriber_price_cents")
  requiresHumanReview     Boolean @default(false) @map("requires_human_review")
  sortOrder               Int     @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  reportOrders ReportOrder[]

  @@map("report_tiers")
}

enum ReportPriceBasis {
  subscriber
  non_subscriber

  @@map("report_price_basis")
}

// Full fulfillment state machine per ARCHITECTURE.md's report purchase ->
// fulfillment path. Essential/Investor/Professional (this pass's automated
// tiers) only ever exercise pending_payment -> queued -> generating ->
// delivered/failed; awaiting_review/approved exist now so Premium's future
// human-review routing doesn't require a breaking enum change later.
enum ReportOrderStatus {
  pending_payment
  queued
  generating
  awaiting_review
  approved
  delivered
  failed
  refunded

  @@map("report_order_status")
}

model ReportOrder {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reportTierCode String     @map("report_tier_code")
  reportTier     ReportTier @relation(fields: [reportTierCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  pricePaidCents            Int               @map("price_paid_cents")
  priceBasis                ReportPriceBasis  @map("price_basis")
  upgradeCreditAppliedCents Int               @default(0) @map("upgrade_credit_applied_cents")
  status                    ReportOrderStatus @map("status")

  stripeCheckoutSessionId String? @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @map("stripe_payment_intent_id")

  // Persisted AI-generated report content once status = delivered; null
  // until then. Shape per REQUIREMENTS.md decision log #10 (tier-scoped-
  // depth AI investment analysis) — application-layer concern, not enforced
  // at the DB level, matching `ai_interactions.response`'s existing pattern.
  content Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supportTickets SupportTicket[]

  @@index([userId])
  @@index([propertyId])
  @@index([reportTierCode])
  @@index([status])
  @@map("report_orders")
}

// ---------------------------------------------------------------------------
// Support Center — real ticketing, per REQUIREMENTS.md Section 10.2/Section
// 6 ("Support Center — ticket table, detail panel, conversation, internal
// notes, related orders, user/property profile, support tools") and the
// Support Agent persona (Section 9.4). No ticketing system or refund
// capability existed before this pass — `report-generation.service.ts`'s
// doc comment explicitly deferred refunds as "a future admin/support
// feature." This is that feature: investors file real tickets from
// investor-web, admins work them from admin-web, and a ticket tied to a
// ReportOrder can trigger a real Stripe refund (using the order's already-
// stored `stripePaymentIntentId`) which flips that order to `refunded` —
// the enum value already existed, unused, until now.
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed

  @@map("support_ticket_status")
}

enum SupportMessageSenderType {
  user
  admin

  @@map("support_message_sender_type")
}

model SupportTicket {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  subject String
  status  SupportTicketStatus @default(open)

  // Optional context a ticket can be filed against — a billing/report
  // problem points at the order, a data-quality complaint points at the
  // property. Both nullable and independent; a ticket can carry neither,
  // either, or (a report-delivery complaint about a specific property)
  // both.
  relatedReportOrderId String?      @map("related_report_order_id") @db.Uuid
  relatedReportOrder   ReportOrder? @relation(fields: [relatedReportOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  relatedPropertyId String?   @map("related_property_id") @db.Uuid
  relatedProperty   Property? @relation(fields: [relatedPropertyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  assignedAdminId String?    @map("assigned_admin_id") @db.Uuid
  assignedAdmin   AdminUser? @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([relatedReportOrderId])
  @@map("support_tickets")
}

// A ticket's conversation. `isInternalNote` rows are admin-only annotations
// (never returned by the investor-facing endpoints) — same table rather
// than a separate one, since a note is structurally identical to a message,
// just not user-visible.
model SupportTicketMessage {
  id String @id @default(uuid()) @db.Uuid

  ticketId String        @map("ticket_id") @db.Uuid
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  senderType SupportMessageSenderType @map("sender_type")

  senderUserId String? @map("sender_user_id") @db.Uuid
  senderUser   User?   @relation("SupportTicketMessageUserSender", fields: [senderUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  senderAdminId String?    @map("sender_admin_id") @db.Uuid
  senderAdmin   AdminUser? @relation("SupportTicketMessageAdminSender", fields: [senderAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  body           String  @db.Text
  isInternalNote Boolean @default(false) @map("is_internal_note")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// ---------------------------------------------------------------------------
// AI call logging — real success/failure/latency for every Anthropic call
// ---------------------------------------------------------------------------
//
// Added for the AI & Model Monitoring admin module. Before this, only
// *successful* AI Analyst answers were ever persisted (`AiInteraction`,
// whose own doc comment explicitly scopes it to "the model answered and
// here's what it said" — never a placeholder for a failed call). Every
// failure was only `Logger.error`'d to console, with no queryable
// history — `ai_analysis.service.ts`'s doc comment flagged this exact
// gap for follow-up ("add a separate ai_interaction_failures table or a
// nullable response/status column"). This is that table, logging both
// outcomes (not just failures) so it also covers real response-time and
// volume data `ai_interactions` never captured either.
//
// Written from the one shared choke point both AI features go through —
// `AnthropicToolCallerService.callForcedTool` — so instrumenting it once
// covers the free AI Analyst (`AiAnalysisService`) and purchased-report
// generation (`ReportGenerationService`) identically, not by threading
// logging through each caller separately.
enum AiCallStatus {
  succeeded
  failed

  @@map("ai_call_status")
}

model AiCallLog {
  id String @id @default(uuid()) @db.Uuid

  // Small closed set today ("ai_analyst", "report_generation") but kept as
  // a free string per this schema's established convention for evolving
  // categorical fields (risk_type, action, permission_key) — a third AI
  // feature shouldn't need a migration to log here.
  feature String

  // The caller-supplied `logContext` value (e.g. "property <uuid>",
  // "report order <uuid>") — human-readable identifier for the activity
  // feed, not a foreign key (a call can fail before any row it might
  // reference exists).
  detail String

  model  String
  status AiCallStatus

  durationMs   Int     @map("duration_ms")
  outputTokens Int?    @map("output_tokens")
  errorMessage String? @map("error_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([feature])
  @@index([createdAt])
  @@map("ai_call_logs")
}

// ---------------------------------------------------------------------------
// Real Florida parcel records — the first real property-fundamentals data
// ---------------------------------------------------------------------------
//
// Every row in `properties` is still fabricated seed data (see that
// model's own file-header comment) — this table is deliberately separate
// from it, not a partial real/fake merge into the same rows. Merging real
// government parcel data into rows that still carry a fabricated asking
// price would make the fabricated part look more credible by
// association, which is worse than keeping the two clearly apart.
//
// Populated by apps/api/src/ingestion/fl-parcel-cadastral-ingestion.service.ts
// from the Florida Department of Revenue's real, public statewide parcel
// cadastral dataset (Property Tax Oversight program; ArcGIS FeatureServer,
// same integration pattern as the FEMA flood-zone job — see
// `IngestionRun`'s doc comment). Filtered to real DOR agricultural land
// use codes (50-69, per the Department's own published code table) in
// the platform's covered counties, so this table holds genuinely
// agricultural parcels, not incidental residential/government/vacant
// land that happens to sit at a queried point.
//
// Deliberately does NOT include `askingPriceCents` or a "for sale"
// listing status — county tax-roll data has no concept of either. `jv`
// (Just Value) is Florida's tax-assessment figure, a real number but not
// a market appraisal; stored and labeled as such, not conflated with
// `properties.valuation.estimatedValueCents`. Turning real parcels into
// real, priced investment listings is a separate, still-open problem
// (no legitimate free/public source for current FL ag land listings
// exists — see the real-data-sourcing research this table came out of).
model ParcelRecord {
  id String @id @default(uuid()) @db.Uuid

  source String @default("fl_dor_cadastral")

  // Real Florida county name, resolved from the Department of Revenue's
  // own CO_NO county-number field — empirically verified against real
  // parcels for each of this platform's covered counties (not assumed
  // from a published code table), by `fl-parcel-cadastral-ingestion.service.ts`.
  county   String
  parcelId String @map("parcel_id")

  ownerName        String? @map("owner_name")
  siteAddress      String? @map("site_address")
  siteCity         String? @map("site_city")
  legalDescription String? @map("legal_description") @db.Text

  // Real DOR Use Code (e.g. "066" = Orchard Groves/Citrus) plus the
  // human-readable description from the Department's own published
  // code table — both stored, since the raw code is the real source of
  // truth and the description is this app's own translation of it.
  dorUseCode        String @map("dor_use_code")
  dorUseDescription String @map("dor_use_description")

  acreage        Decimal @db.Decimal(10, 2)
  justValueCents Int     @map("just_value_cents")
  assessmentYear Int?    @map("assessment_year")

  ingestedAt DateTime @default(now()) @map("ingested_at")

  @@unique([source, parcelId])
  @@index([county])
  @@index([dorUseCode])
  @@map("parcel_records")
}
